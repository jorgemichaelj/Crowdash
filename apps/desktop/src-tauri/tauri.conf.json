{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrowDash",
  "version": "0.1.0",
  "identifier": "com.crowdash.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @crowdash/extension build && pnpm dev",
    "beforeBuildCommand": "pnpm --filter @crowdash/extension build && pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CrowDash",
        "width": 1100,
        "height": 740,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../extension/dist/": "extension/"
    },
    "externalBin": [],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
