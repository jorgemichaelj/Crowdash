{
  "manifest_version": 3,
  "name": "CrowDash Companion",
  "version": "0.1.0",
  "description": "Detecte vídeos e músicas e envie os downloads para o CrowDash.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CrowDash"
  },
  "permissions": [
    "webRequest",
    "downloads",
    "storage",
    "activeTab",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "128": "crowdash-logo.png"
  }
}
